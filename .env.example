# Database
POSTGRES_USER=eventguard
POSTGRES_PASSWORD=eventguard
POSTGRES_DB=eventguard
POSTGRES_PORT=5433
DATABASE_URL=postgresql://eventguard:eventguard@localhost:5433/eventguard

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Backend
BACKEND_PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001

# Phase 9: Razorpay Webhook Integration (TEST MODE ONLY)
# Get test credentials from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Phase 10: Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Phase 10: CORS
CORS_ORIGIN=http://localhost:5173

# Authentication (HS256 JWT). JWT_SECRET must be at least 32 random characters;
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=3600
# Demo login issues tokens without a user store. Keep it off in production
# (the backend refuses to start with it enabled when NODE_ENV=production).
AUTH_DEMO_LOGIN=true
# Shared secret required by demo login before it issues an admin token (16+ chars)
ADMIN_API_KEY=replace-with-a-long-random-admin-key

