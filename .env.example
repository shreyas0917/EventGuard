# Database
POSTGRES_USER=eventguard
POSTGRES_PASSWORD=eventguard
POSTGRES_DB=eventguard
POSTGRES_PORT=5433
DATABASE_URL=postgresql://eventguard:eventguard@localhost:5433/eventguard

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Backend
BACKEND_PORT=3001
NODE_ENV=development

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3001

# Phase 9: Razorpay Webhook Integration (TEST MODE ONLY)
# Get test credentials from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Phase 10: Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Phase 10: CORS
CORS_ORIGIN=http://localhost:5173
