{
  "name": "eventguard-backend",
  "version": "0.1.0",
  "description": "EventGuard backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker:outbox": "tsx watch src/outboxWorkerProcess.ts",
    "worker:events": "tsx watch src/eventConsumer.ts",
    "test": "tsx tests/integration.test.ts",
    "test:phase3": "tsx tests/phase3.test.ts",
    "test:phase4": "tsx tests/phase4.test.ts",
    "test:phase5": "tsx tests/phase5.test.ts",
    "test:phase6": "tsx tests/phase6.test.ts",
    "lint": "eslint src --ext .ts",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "prisma": "^5.20.0",
    "razorpay": "^2.9.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
